NEXT_PUBLIC_USERNAME=admin
NEXT_PUBLIC_PASSWORD=admin
NEXT_PUBLIC_BASE_URL=http://localhost:8002
NEXT_PUBLIC_ASSETS_BASE_URL=

# --- Godham Trust (NGO) site ---
# Server-side only (no NEXT_PUBLIC_ prefix) — set these as regular
# Environment Variables in the Vercel project settings, not in NEXT_PUBLIC_*.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Password admin must enter at /godham/admin to upload/delete photos & the QR code.
GODHAM_ADMIN_PASSWORD=choose-a-strong-password
